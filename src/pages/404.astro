---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homePath, url } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { asset } from '../lib/images';

const pt = useTranslations('pt-br');
const en = useTranslations('en');
---

<BaseLayout title={`404 — ${pt.notFound.title}`} description={pt.notFound.text} path="/404/" noindex>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-5 py-20 text-center">
    <div class="relative w-40" aria-hidden="true">
      <Image
        src={asset('brand/gatos.png')}
        alt=""
        widths={[200]}
        sizes="140px"
        class="float absolute -top-6 -left-28 w-32"
      />
      <Image src={asset('brand/avatar.png')} alt="" widths={[200, 368]} sizes="160px" class="w-full" />
    </div>
    <p class="heading-display mt-8 text-display text-accent-text">404</p>
    <h1 class="heading-display mt-2 text-3xl">{pt.notFound.title}</h1>
    <p class="mt-3 text-lg text-text-muted">{pt.notFound.text}</p>
    <p class="mt-1 text-text-muted" lang="en">
      {en.notFound.text}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={url(homePath['pt-br'])}
        class="rounded-md bg-accent px-5 py-3 font-semibold text-on-accent no-underline hover:bg-accent-hover"
      >
        {pt.notFound.cta}
      </a>
      <a
        href={url(homePath.en)}
        lang="en"
        class="rounded-md border border-border px-5 py-3 font-semibold no-underline hover:border-accent"
      >
        {en.notFound.cta}
      </a>
    </div>
  </section>
</BaseLayout>
