---
import { Image } from 'astro:assets';
import { localize, url, type Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import { getProfile } from '../../lib/content';
import { asset } from '../../lib/images';
import YouTubeFacade from '../ui/YouTubeFacade.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
const opportunities = localize(profile.opportunities, locale);
---

<section class="mx-auto max-w-6xl px-5 pb-10" aria-labelledby="covers-title">
  <div class="grid items-center gap-6 rounded-lg border border-border bg-card p-5 md:grid-cols-[0.9fr_1.1fr] md:p-8">
    <div>
      <p class="eyebrow">// {t.covers.eyebrow}</p>
      <h2 id="covers-title" class="heading-display mt-2 text-3xl">
        {t.covers.title}
      </h2>
      <p class="mt-3 text-text-muted">{t.covers.traitor}</p>
    </div>
    <YouTubeFacade id="0FfBJQdFeB4" title={t.covers.traitor} locale={locale} />
  </div>
</section>

<section id="contact" class="relative scroll-mt-20 overflow-hidden" aria-labelledby="contact-title">
  <div class="bg-brand pointer-events-none absolute inset-0 -z-10 opacity-25" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-6xl items-end gap-10 px-5 py-20 md:grid-cols-[1fr_auto]">
    <div>
      <p class="eyebrow">// {t.contact.eyebrow}</p>
      <h2 id="contact-title" class="heading-display mt-2 text-5xl md:text-6xl">
        {t.contact.title}
      </h2>
      <p class="mt-4 text-lg text-text-muted">{t.contact.text}:</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {opportunities.map((o) => (
          <li class="rounded-sm border border-accent bg-bg/70 px-3 py-1 font-mono text-sm">{o}</li>
        ))}
      </ul>

      <dl class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-md border border-border bg-bg/70 p-4">
          <dt class="font-mono text-xs text-text-muted uppercase">{t.contact.email}</dt>
          <dd class="mt-1 font-semibold break-all">
            <a href={`mailto:${profile.email}`} class="hover:text-accent-text">
              {profile.email}
            </a>
          </dd>
        </div>
        <div class="rounded-md border border-border bg-bg/70 p-4">
          <dt class="font-mono text-xs text-text-muted uppercase">{t.contact.phone}</dt>
          <dd class="mt-1 font-semibold">
            <a href={`tel:${profile.phone.href}`} class="hover:text-accent-text">
              {profile.phone.display}
            </a>
          </dd>
        </div>
        <div class="rounded-md border border-border bg-bg/70 p-4">
          <dt class="font-mono text-xs text-text-muted uppercase">{t.contact.location}</dt>
          <dd class="mt-1 font-semibold">{localize(profile.location, locale)}</dd>
        </div>
      </dl>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${profile.email}`}
          class="rounded-md bg-accent px-5 py-3 font-semibold text-on-accent no-underline transition-colors hover:bg-accent-hover"
        >
          {t.hero.contact}
        </a>
        <a
          href={url(profile.cv)}
          class="rounded-md border border-border bg-bg/70 px-5 py-3 font-semibold no-underline hover:border-accent"
        >
          {t.contact.cv}
        </a>
        <ul class="flex flex-wrap gap-2">
          {profile.profiles.map((p) => (
            <li>
              <a
                href={p.url}
                rel="me noopener"
                target="_blank"
                class="inline-block rounded-sm border border-border bg-bg/70 px-3 py-2 font-mono text-sm no-underline hover:border-accent hover:text-accent-text"
              >
                {p.network}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="relative mx-auto w-48 md:w-56" aria-hidden="true">
      <Image
        src={asset('brand/gatos.png')}
        alt=""
        widths={[200, 300]}
        sizes="160px"
        class="float absolute -top-10 -left-24 w-36 opacity-90"
      />
      <Image
        src={asset('brand/avatar.png')}
        alt=""
        widths={[224, 368]}
        sizes="224px"
        class="relative w-full"
      />
    </div>
  </div>
</section>
