---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { localize, projectPath, url, type Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import type { Project } from '../../lib/content';
import { asset } from '../../lib/images';
import SectionHeading from '../ui/SectionHeading.astro';
import SoundCard from '../ui/SoundCard.astro';

interface Props {
  projects: Project[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const t = useTranslations(locale);
const featured = projects.filter((p) => p.data.featured);
const awards = await getCollection('awards');

function signature(project: Project) {
  const { tracks, sfx } = project.data;
  const original = sfx.filter((s) => !s.curated);
  if (tracks[0]) return { audio: tracks[0].audio, label: localize(tracks[0].title, locale) };
  const pick = original.find((s) => s.category !== 'ui') ?? original[0];
  return pick ? { audio: pick.audio, label: localize(pick.label, locale) } : undefined;
}
---

<section class="mx-auto max-w-6xl px-5 py-20" aria-labelledby="featured-title">
  <SectionHeading id="featured-title" eyebrow={t.featured.eyebrow} title={t.featured.title} />
  <div class="flex flex-col gap-10">
    {featured.map((project, i) => {
      const sound = signature(project);
      const projectAwards = awards.filter((a) => a.data.project?.id === project.id);
      return (
        <article
          class:list={[
            'reveal grid items-center gap-6 md:grid-cols-2 md:gap-10',
            i % 2 === 1 && 'md:[&>*:first-child]:order-2',
          ]}
        >
          <a
            href={url(projectPath(project.id, locale))}
            class="group relative block"
            tabindex="-1"
            aria-hidden="true"
          >
            <div class="selection-box overflow-hidden rounded-sm p-1.5">
              <span class="handle -top-1 -left-1" />
              <span class="handle -top-1 -right-1" />
              <span class="handle -bottom-1 -left-1" />
              <span class="handle -right-1 -bottom-1" />
              <Image
                src={asset(project.data.cover)}
                alt=""
                widths={[480, 720, 960]}
                sizes="(min-width: 768px) 540px, 100vw"
                class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
          </a>
          <div>
            <p class="font-mono text-xs text-text-muted">
              {localize(project.data.context, locale)} · {project.data.engine}
            </p>
            <h3 class="heading-display mt-2 text-4xl md:text-5xl">{project.data.title}</h3>
            {projectAwards.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-2">
                {projectAwards
                  .sort((a, b) => a.data.order - b.data.order)
                  .map((a) => (
                    <li class="rounded-sm border border-accent px-2 py-0.5 font-mono text-xs text-accent-text">
                      {localize(a.data.title, locale)}
                    </li>
                  ))}
              </ul>
            )}
            <p class="mt-4 text-lg text-text-muted">{localize(project.data.hook, locale)}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={t.project.deliverables}>
              {project.data.deliverables.map((d) => (
                <li class="rounded-sm bg-surface px-2 py-0.5 font-mono text-xs">{t.deliverables[d]}</li>
              ))}
            </ul>
            {sound && (
              <div class="mt-5">
                <SoundCard audio={sound.audio} label={sound.label} locale={locale} size="lg" />
              </div>
            )}
            <a
              href={url(projectPath(project.id, locale))}
              class="mt-5 inline-flex items-center gap-2 font-semibold text-accent-text underline-offset-4 hover:underline"
            >
              {t.featured.cta}: {project.data.title} →
            </a>
          </div>
        </article>
      );
    })}
  </div>
</section>
