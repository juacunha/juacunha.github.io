---
import { Image } from 'astro:assets';
import { localize, projectPath, url, type Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import type { Project } from '../../lib/content';
import { asset } from '../../lib/images';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const { data } = project;
const t = useTranslations(locale);
---

<article class="card-lift group relative flex w-full flex-col overflow-hidden rounded-lg border border-border bg-card">
  <div class="relative aspect-video overflow-hidden bg-surface">
    <Image
      src={asset(data.cover)}
      alt={localize(data.coverAlt, locale)}
      widths={[400, 640]}
      sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
    />
    <span class="absolute top-2 left-2 rounded-sm bg-bg/85 px-2 py-0.5 font-mono text-xs uppercase">
      {t.status[data.status]}
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div>
      <h3 class="text-xl leading-tight font-bold">
        <a
          href={url(projectPath(project.id, locale))}
          class="no-underline after:absolute after:inset-0 hover:text-accent-text"
        >
          {data.title}
        </a>
      </h3>
      <p class="mt-1 font-mono text-xs text-text-muted">
        {localize(data.context, locale)} · {data.engine}
      </p>
    </div>
    <p class="text-text-muted">{localize(data.hook, locale)}</p>
    <ul class="mt-auto flex flex-wrap gap-1.5 pt-2" aria-label={t.project.deliverables}>
      {data.deliverables.slice(0, 5).map((d) => (
        <li class="rounded-sm border border-border px-2 py-0.5 font-mono text-xs">{t.deliverables[d]}</li>
      ))}
      {data.deliverables.length > 5 && (
        <li class="px-1 py-0.5 font-mono text-xs text-text-muted">+{data.deliverables.length - 5}</li>
      )}
    </ul>
  </div>
</article>
