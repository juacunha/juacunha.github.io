---
import { localize, type Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import { boardSounds, type Project } from '../../lib/content';
import { sfxCategories } from '../../lib/taxonomy';
import FilterBar from '../islands/FilterBar.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import SoundCard from '../ui/SoundCard.astro';

interface Props {
  projects: Project[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const t = useTranslations(locale);
// Intercala os projetos para a prévia não mostrar só um jogo.
const byProject = Map.groupBy(boardSounds(projects), (s) => s.project.id);
const longest = Math.max(...[...byProject.values()].map((g) => g.length));
const sounds = Array.from({ length: longest }, (_, i) => [...byProject.values()].map((g) => g[i]))
  .flat()
  .filter(Boolean);
const present = sfxCategories.filter((c) => sounds.some((s) => s.category === c));
// Mantenha igual ao nth-child de .sound-list[data-collapsed] em global.css.
const preview = 9;
---

<section
  id="sounds"
  class="brand-rule relative scroll-mt-20 bg-surface/40"
  aria-labelledby="sounds-title"
  data-filter-scope
>
  <div class="mx-auto max-w-6xl px-5 py-20">
    <SectionHeading id="sounds-title" eyebrow={t.board.eyebrow} title={t.board.title} intro={t.board.intro} />
    <FilterBar
      label={t.board.filterLabel}
      allLabel={`${t.board.all} (${sounds.length})`}
      options={present.map((c) => ({
        value: c,
        label: `${t.board.categories[c]} (${sounds.filter((s) => s.category === c).length})`,
      }))}
    />
    <ul id="sound-list" class="sound-list grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {sounds.map((s) => (
        <li data-tags={s.category}>
          <SoundCard
            audio={s.audio}
            label={localize(s.label, locale)}
            meta={`${t.board.categories[s.category]} · ${s.project.data.title}`}
            locale={locale}
          />
        </li>
      ))}
    </ul>
    {sounds.length > preview && (
      <div class="mt-6 flex justify-center">
        <button
          type="button"
          class="sound-more rounded-md border border-border bg-bg/60 px-5 py-3 font-semibold transition-colors hover:border-accent hover:text-accent-text"
          aria-controls="sound-list"
          aria-expanded="false"
          data-label-more={`${t.board.showAll} (${sounds.length})`}
          data-label-less={t.board.showLess}
          hidden
        >
          {`${t.board.showAll} (${sounds.length})`}
        </button>
      </div>
    )}
  </div>
</section>

<script>
  // Sem JS a lista aparece inteira. Com JS, mostra uma prévia enquanto o filtro está em "Todos".
  const list = document.querySelector<HTMLElement>('.sound-list');
  const more = document.querySelector<HTMLButtonElement>('.sound-more');
  if (list && more) {
    let expanded = false;
    let filtered = false;
    const sync = () => {
      list.toggleAttribute('data-collapsed', !expanded && !filtered);
      more.hidden = filtered;
      more.setAttribute('aria-expanded', String(expanded));
      more.textContent = (expanded ? more.dataset.labelLess : more.dataset.labelMore) ?? '';
    };
    more.addEventListener('click', () => {
      expanded = !expanded;
      if (!expanded) list.closest('section')?.scrollIntoView({ block: 'start' });
      sync();
    });
    list
      .closest('[data-filter-scope]')
      ?.querySelector('.filter-bar')
      ?.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
        if (button) {
          filtered = (button.dataset.filter ?? '') !== '';
          sync();
        }
      });
    sync();
  }
</script>
