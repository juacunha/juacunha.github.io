---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { localize, url, type Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import { getProfile, getSorted } from '../../lib/content';
import { asset } from '../../lib/images';
import Decor from '../ui/Decor.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile();
const awards = await getSorted('awards');
const awardProjects = await Promise.all(
  awards.map((a) => (a.data.project ? getEntry(a.data.project) : undefined)),
);
---

<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <Decor kind="stripes" class="absolute bottom-36 left-0 hidden h-20 w-32 text-indigo md:block" />

  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 pt-14 pb-16 md:grid-cols-[1.15fr_0.85fr] md:pt-20 md:pb-24">
    <div class="relative">
      <p class="eyebrow hero-in">{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="heading-display hero-in mt-4 text-display" style="--d: 80ms">
        Juliana <span class="text-accent">Acunha</span>
      </h1>
      <p class="hero-in mt-5 inline-flex flex-wrap items-center gap-3" style="--d: 180ms">
        <span class="selection-box px-3 py-1.5 font-mono text-sm md:text-base">
          <span class="handle -top-1 -left-1"></span>
          <span class="handle -top-1 -right-1"></span>
          <span class="handle -bottom-1 -left-1"></span>
          <span class="handle -right-1 -bottom-1"></span>
          {localize(profile.label, locale)}
        </span>
      </p>
      <p class="hero-in mt-5 max-w-xl text-lg text-text-muted md:text-xl" style="--d: 260ms">
        {localize(profile.tagline, locale)}
      </p>
      <p class="hero-in mt-4 max-w-xl border-l-2 border-accent pl-4 text-lg italic" style="--d: 340ms">
        “{localize(profile.intro, locale)}”
      </p>

      <div class="hero-in mt-8 flex flex-wrap gap-3" style="--d: 420ms">
        <a
          href="#reel"
          class="inline-flex items-center gap-2 rounded-md bg-accent px-5 py-3 font-semibold text-on-accent no-underline transition-colors hover:bg-accent-hover"
        >
          <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
            <path d="M6 4l11 6-11 6z" fill="currentColor"></path>
          </svg>
          {t.hero.reel}
        </a>
        <a
          href="#sounds"
          class="inline-flex items-center gap-2 rounded-md border border-border px-5 py-3 font-semibold no-underline transition-colors hover:border-accent hover:text-accent-text"
        >
          <span class="eq" aria-hidden="true">
            <span></span>
            <span class="h-[70%]!"></span>
            <span class="h-[55%]!"></span>
          </span>
          {t.hero.listen}
        </a>
        <a
          href={url(profile.cv)}
          class="inline-flex items-center px-2 py-3 font-mono text-sm text-text-muted underline-offset-4 hover:text-accent-text hover:underline"
        >
          {t.hero.cv} ↓
        </a>
      </div>
    </div>

    <div class="hero-photo relative mx-auto w-full max-w-sm md:max-w-none">
      <Decor kind="scribble" class="absolute -top-8 -right-6 z-0 w-40 md:w-52" />
      <Decor kind="halftone" class="absolute -bottom-8 -left-8 z-0 h-32 w-32 opacity-60" />
      <div class="selection-box relative z-10 rotate-1 p-2">
        <span class="handle -top-1 -left-1"></span>
        <span class="handle -top-1 -right-1"></span>
        <span class="handle -bottom-1 -left-1"></span>
        <span class="handle -right-1 -bottom-1"></span>
        <Image
          src={asset('brand/foto.jpeg')}
          alt={t.hero.photoAlt}
          widths={[360, 540, 720]}
          sizes="(min-width: 768px) 380px, 90vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[3/4] w-full object-cover"
        />
      </div>
    </div>
  </div>

  <div class="brand-rule relative bg-surface/60">
    <ul class="mx-auto flex max-w-6xl flex-wrap gap-3 px-5 py-4" aria-label={t.awards.title}>
      {awards.map((award, i) => (
        <li
          class:list={[
            'flex items-center gap-2 rounded-sm border px-3 py-1.5 font-mono text-xs md:text-sm',
            award.data.highlight ? 'border-accent bg-accent text-on-accent' : 'border-border',
          ]}
        >
          <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0" aria-hidden="true">
            <path
              d="M6 2h8v3a4 4 0 0 1-8 0zM4 3H2v2a3 3 0 0 0 3 3M16 3h2v2a3 3 0 0 1-3 3M10 9v4M7 17h6l-1-4H8z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            />
          </svg>
          <span>
            <strong class="font-bold">{localize(award.data.title, locale)}</strong> · {award.data.edition}
            {awardProjects[i] && <span> · {awardProjects[i].data.title}</span>}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
