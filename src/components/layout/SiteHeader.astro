---
import { homePath, otherLocale, url, type Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
  alternate?: { locale: Locale; path: string };
}

const { locale, alternate } = Astro.props;
const t = useTranslations(locale);
const home = url(homePath[locale]);
const links = [
  { href: `${home}#sounds`, label: t.nav.sounds },
  { href: `${home}#projects`, label: t.nav.projects },
  { href: `${home}#process`, label: t.nav.process },
  { href: `${home}#about`, label: t.nav.about },
  { href: `${home}#contact`, label: t.nav.contact },
];
const switchHref = url(alternate?.path ?? homePath[otherLocale(locale)]);
---

<header class="sticky top-0 z-40 border-b border-border/60 bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
    <a href={home} class="heading-display text-xl tracking-wide no-underline hover:text-accent-text">
      Juliana Acunha
    </a>
    <nav aria-label={t.nav.label} class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-sm px-3 py-2 font-mono text-sm text-text-muted no-underline transition-colors hover:text-text"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={switchHref}
        hreflang={otherLocale(locale) === 'en' ? 'en' : 'pt-BR'}
        aria-label={t.lang.switchLabel}
        class="ml-1 rounded-sm border border-border px-2.5 py-1.5 font-mono text-xs font-semibold no-underline hover:border-accent hover:text-accent-text"
      >
        {t.lang.switchTo}
      </a>
      <details class="group relative md:hidden">
        <summary class="ml-1 flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-sm border border-border [&::-webkit-details-marker]:hidden">
          <span class="sr-only">Menu</span>
          <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
            <path
              d="M3 5h14M3 10h14M3 15h14"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            ></path>
          </svg>
        </summary>
        <ul class="absolute right-0 mt-2 w-48 rounded-md border border-border bg-surface p-2 shadow-glow">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-sm px-3 py-2.5 font-mono text-sm no-underline hover:bg-card"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
</header>
