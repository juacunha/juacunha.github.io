---
import '@fontsource/anton/400.css';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import { defaultLocale, htmlLang, url, type Locale } from '../i18n';
import { useTranslations } from '../i18n/ui';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import AudioEngine from '../components/islands/AudioEngine.astro';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Caminho equivalente no outro idioma (sem base), para o seletor e o hreflang. */
  alternate?: { locale: Locale; path: string };
  path: string;
  jsonLd?: object;
  noindex?: boolean;
}

const { title, description, locale = defaultLocale, alternate, path, jsonLd, noindex = false } = Astro.props;
const t = useTranslations(locale);
const canonical = new URL(url(path), Astro.site);
const ogImage = new URL(url('/og.jpg'), Astro.site);
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={htmlLang[locale]} href={canonical} />
    {alternate && (
      <link
        rel="alternate"
        hreflang={htmlLang[alternate.locale]}
        href={new URL(url(alternate.path), Astro.site)}
      />
    )}
    {alternate && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(url(locale === defaultLocale ? path : alternate.path), Astro.site)}
      />
    )}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#140a40" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={htmlLang[locale].replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-dvh bg-bg text-text">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:font-mono focus:text-on-accent"
    >
      {t.skipLink}
    </a>
    <SiteHeader locale={locale} alternate={alternate} />
    <main id="conteudo">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <AudioEngine />
  </body>
</html>
